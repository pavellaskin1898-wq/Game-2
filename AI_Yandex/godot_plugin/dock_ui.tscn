<?xml version="1.0" encoding="UTF-8"?>
<root type="module">
	<Control name="DockPanel" layout="vertical" size_flags_horizontal="4" size_flags_vertical="4">
		<Label name="TitleLabel" text="AI_Yandex (Автор: LaskinPO)" horizontal_alignment="1" />
		<HSeparator />
		
		<VBoxContainer name="AuthContainer">
			<Label text="Логин Яндекс:" />
			<LineEdit name="LoginInput" placeholder_text="Введите логин" />
			
			<Label text="Пароль Яндекс:" />
			<LineEdit name="PasswordInput" placeholder_text="Введите пароль" secret="true" />
			
			<Button name="GetTokenBtn" text="🔑 Получить токен" />
		</VBoxContainer>
		
		<VBoxContainer name="ConnectionContainer">
			<Button name="ConnectBtn" text="📡 Подключиться к серверу" />
			<CheckBox name="AutoCheck" text="🔄 Автономная работа" />
		</VBoxContainer>
		
		<HSeparator />
		
		<Label name="StatusLabel" text="Статус: Не подключено" horizontal_alignment="1" />
	</Control>
</root>
